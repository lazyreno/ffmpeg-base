{
  "name": "ffmpeg-base",
  "sdkVersion": "@SDK_VERSION@",
  "ffmpegVersion": "@FFMPEG_VERSION@",
  "platform": "@SDK_PLATFORM@",
  "arch": "@SDK_ARCH@",
  "minimumSystemVersion": "@MINIMUM_SYSTEM_VERSION@",
  "compiler": "@SDK_COMPILER@",
  "vcpkgBaseline": "@VCPKG_BASELINE@",
  "vcpkgTriplet": "@VCPKG_TRIPLET@",
  "ffmpegSourceUrl": "@FFMPEG_SOURCE_URL@",
  "ffmpegSourceSha256": "@FFMPEG_SOURCE_SHA256@",
  "featureProfile": "@FEATURE_PROFILE@",
  "externalDependencies": @SDK_EXTERNAL_DEPENDENCIES_JSON@,
  "componentsFile": "components.json",
  "licenseMode": "@LICENSE_MODE@",
  "buildId": "@BUILD_ID@",
  "createdAt": "@CREATED_AT@"
}
