cmake_minimum_required(VERSION 3.21)
set(repo_root "${CMAKE_CURRENT_LIST_DIR}/../..")
file(READ "${repo_root}/.github/workflows/build-desktop.yml" workflow)
file(READ "${repo_root}/config/platform-matrix.json" matrix)
file(READ "${repo_root}/templates/manifest.json.in" manifest)

function(require_text content needle description)
  string(FIND "${content}" "${needle}" position)
  if(position EQUAL -1)
    message(FATAL_ERROR "${description}: missing ${needle}")
  endif()
endfunction()

function(forbid_text content needle description)
  string(FIND "${content}" "${needle}" position)
  if(NOT position EQUAL -1)
    message(FATAL_ERROR "${description}: unexpected ${needle}")
  endif()
endfunction()

foreach(platform IN ITEMS macos-arm64 macos-x86_64 windows-x86_64 windows-arm64)
  require_text("${matrix}" "\"key\": \"${platform}\"" "Four native platforms required")
endforeach()
require_text("${matrix}" "\"runner\": \"macos-15\"" "macOS arm64 runner must be supported")
forbid_text("${matrix}" "\"profile\"" "Old artifact profiles must be removed")
forbid_text("${manifest}" "@ARTIFACT_PROFILE@" "Manifest must not carry old artifact profile")

forbid_text("${workflow}" "preflight-sdk:" "Manual builds use the full SDK build")
require_text("${workflow}" "needs: prepare-matrix" "Build must use the platform matrix")
require_text("${workflow}" "if: github.event_name == 'workflow_dispatch'" "Manual build must be explicit")
require_text("${workflow}" "package-candidate:" "Candidate package required")
require_text("${workflow}" "tar -C" "SDK transfer must preserve permissions")
require_text("${workflow}" "tar -xf" "Candidate package must restore SDK transfer")
require_text("${workflow}" "candidate-assets/\${sdk_name}.zip" "Candidate ZIPs required")
require_text("${workflow}" "candidate-assets/\${sdk_name}.zip.sha256" "Candidate checksums required")
require_text("${workflow}" "generate-artifact-index.py" "Candidate index required")
require_text("${workflow}" "validate-candidate-assets.py" "Candidate ZIP contents must be validated")
require_text("${workflow}" "Upload unpublished candidate" "Candidate must remain a workflow artifact")
forbid_text("${workflow}" "gh release create" "Build workflow must not publish a Release")
forbid_text("${workflow}" "publish-release:" "Build workflow must not have a release job")
forbid_text("${workflow}" "      - \"v*\"" "Tag push must not trigger a rebuild")

file(READ "${repo_root}/.github/workflows/publish-desktop.yml" publish_workflow)
require_text("${publish_workflow}" "candidate_run_id" "Publication must select a prior candidate run")
require_text("${publish_workflow}" "minimum_system_evidence" "Publication requires native system evidence")
require_text("${publish_workflow}" "validate-candidate-assets.py" "Publication must verify candidate contents")
forbid_text("${publish_workflow}" "vcpkg install" "Publication must not rebuild dependencies")
forbid_text("${publish_workflow}" "make -j" "Publication must not rebuild FFmpeg")

file(READ "${repo_root}/scripts/build-macos.sh" macos_build)
file(READ "${repo_root}/scripts/build-windows-msvc.ps1" windows_build)
forbid_text("${macos_build}" "zip -qry" "Platform build must not create ZIP")
forbid_text("${windows_build}" "Compress-Archive" "Platform build must not create ZIP")
