cmake_minimum_required(VERSION 3.21)
set(repo_root "${CMAKE_CURRENT_LIST_DIR}/../..")
file(READ "${repo_root}/.github/workflows/build-desktop.yml" workflow)
file(READ "${repo_root}/config/platform-matrix.json" matrix)
file(READ "${repo_root}/templates/manifest.json.in" manifest)

function(require_text content needle description)
  string(FIND "${content}" "${needle}" position)
  if(position EQUAL -1)
    message(FATAL_ERROR "${description}: missing ${needle}")
  endif()
endfunction()

function(forbid_text content needle description)
  string(FIND "${content}" "${needle}" position)
  if(NOT position EQUAL -1)
    message(FATAL_ERROR "${description}: unexpected ${needle}")
  endif()
endfunction()

foreach(platform IN ITEMS macos-arm64 macos-x86_64 windows-x86_64 windows-arm64)
  require_text("${matrix}" "\"key\": \"${platform}\"" "Four native platforms required")
endforeach()
require_text("${matrix}" "\"runner\": \"macos-15\"" "macOS arm64 runner must be supported")
forbid_text("${matrix}" "\"profile\"" "Old artifact profiles must be removed")
forbid_text("${manifest}" "@ARTIFACT_PROFILE@" "Manifest must not carry old artifact profile")

forbid_text("${workflow}" "preflight-sdk:" "Manual builds use the full SDK build")
forbid_text("${workflow}" "Require dependency cache from preflight" "Cache misses must build dependencies")
require_text("${workflow}" "needs: prepare-matrix" "Build must use the platform matrix")
require_text("${workflow}" "      - \"v*\"" "Tag push must trigger a release build")
forbid_text("${workflow}" "if: github.event_name == 'workflow_dispatch'" "Build matrix must run for every configured trigger")
require_text("${workflow}" "publish-release:" "Tag builds must publish from the same workflow")
require_text("${workflow}" "if: startsWith(github.ref, 'refs/tags/v')" "Only tags may publish a Release")
require_text("${workflow}" "tar -C" "SDK transfer must preserve permissions")
require_text("${workflow}" "tar -xf" "Candidate package must restore SDK transfer")
require_text("${workflow}" "release-assets/\${sdk_name}.zip" "Release ZIPs required")
require_text("${workflow}" "release-assets/\${sdk_name}.zip.sha256" "Release checksums required")
require_text("${workflow}" "generate-artifact-index.py" "Release index required")
require_text("${workflow}" "validate-release-assets.py" "Release ZIP contents must be validated")
forbid_text("${workflow}" "Upload unpublished candidate" "Candidate artifact handoff must be removed")
require_text("${workflow}" "gh release create" "Release job must publish the SDK assets")
forbid_text("${workflow}" "package-candidate:" "Candidate packaging must be removed")

if(EXISTS "${repo_root}/.github/workflows/publish-desktop.yml")
  message(FATAL_ERROR "Separate candidate publication workflow must be removed")
endif()

file(READ "${repo_root}/scripts/build-macos.sh" macos_build)
file(READ "${repo_root}/scripts/build-windows-msvc.ps1" windows_build)
forbid_text("${macos_build}" "zip -qry" "Platform build must not create ZIP")
forbid_text("${windows_build}" "Compress-Archive" "Platform build must not create ZIP")
